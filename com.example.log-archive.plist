<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.log-archive</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/log-archive</string>
    <string>--retention</string>
    <string>30</string>
    <string>/var/log</string>
  </array>

  <!-- Every day at 02:00 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/log-archive.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/log-archive.err</string>
</dict>
</plist>
